# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Keenetic Controller Router Configuration
KEENETIC_IP=192.168.1.1
KEENETIC_USERNAME=admin
KEENETIC_PASSWORD=your_keenetic_controller_password
KEENETIC_INSECURE_SKIP_VERIFY=true

# Tracking Configuration
# Check interval, e.g. 30s, 1m, 5m
CHECK_INTERVAL=1m

# Controller offline alert: number of consecutive failed scans before the bot
# sends the "controller unreachable" alert (default 3)
CONTROLLER_FAIL_THRESHOLD=3
